{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mon Spire Editor",
  "version": "0.0.1",
  "identifier": "com.monspire.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Mon Spire Editor", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
